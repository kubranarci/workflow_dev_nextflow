// Day 3 · Level 2 - run from inside this folder:  nextflow run main.nf -profile docker

params.input   = "${projectDir}/../data/samplesheet.csv"
params.targets = "${projectDir}/../data/targets.bed"
params.fasta   = "${projectDir}/../data/genome.fa"      // bash ../data/get_reference.sh ../data

profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// reports for the presentation
report.enabled   = true
report.file      = 'results/pipeline_info/report.html'
report.overwrite = true
dag.enabled      = true
dag.file         = 'results/pipeline_info/dag.html'
dag.overwrite    = true
